---
import { u } from '../lib/url.js';
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { SITE } from '../site.config.js';

const { title, description = SITE.description, bodyClass = '' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site || SITE.url).href;
const nav = [
  { href: '/chapters/', label: 'Chapters', match: '/chapters' },
  { href: '/tactics/', label: 'Tactics', match: '/tactics' },
  { href: '/challenge/', label: 'Habit Challenge', match: '/challenge' },
  { href: '/coach/', label: 'Ask the Coach', match: '/coach', mobileOnly: true },
  { href: '/community/', label: 'Community', match: '/community' },
  { href: '/about/', label: 'About', match: '/about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fbf6ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1a17" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta property="og:image" content={new URL(u('/icon-512.png'), Astro.site || SITE.url).href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
    />
    <script is:inline src={u('/boot.js')}></script>
  </head>
  <body class={bodyClass}>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <nav class="wrap nav" aria-label="Primary">
        <a class="brand" href={u('/')} aria-label={`${SITE.name} — home`}>
          <BrandMark />
          <span class="brand-name">Hopbit<small>Micro incremental habits</small></span>
        </a>
        <ul class="nav-links" id="nav-links">
          {nav.map((n) => (
            <li class={n.mobileOnly ? 'mobile-only' : undefined}><a href={u(n.href)} aria-current={path.startsWith(u(n.match)) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
        <a class="btn btn--ink btn--sm" href={u('/coach/')}>Ask the Coach</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark">
          <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
          <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" data-nav-toggle>
          <span class="sr-only">Menu</span>
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M1 2h16M1 7h16M1 12h11" /></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href={u('/')} style="margin-bottom:14px">
              <BrandMark />
              <span class="brand-name">Hopbit<small>Micro incremental habits</small></span>
            </a>
            <p style="max-width:46ch">
              Hop one small step a day. Twenty chapters of habit ideas turned into micro, incremental systems for work, business, health and home.
            </p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href={u('/chapters/')}>The twenty chapters</a></li>
              <li><a href={u('/tactics/')}>Tactic library</a></li>
              <li><a href={u('/challenge/')}>Habit Challenge (skill test)</a></li>
              <li><a href={u('/coach/')}>Ask the Coach (AI)</a></li>
              <li><a href={u('/community/')}>Community habit journals</a></li>
            </ul>
          </div>
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href={u('/about/#credits')}>Credits &amp; method</a></li>
              <li><a href={u('/about/#privacy')}>Privacy &amp; your API keys</a></li>
              <li><a href={SITE.repo} rel="noopener">Source code</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-legal">
          <strong>Credits:</strong> inspired by the ideas in <em>{SITE.book.title}</em> by {SITE.book.author} ({SITE.book.year}); chapter numbers follow that book. Hopbit is independent and not affiliated with or endorsed by the author or publisher.
          All titles, summaries and tactics are original writing. <a href={u('/about/#credits')}>Full credits</a>.
          Tactics are general guidance, not medical, legal or financial advice.
        </p>
      </div>
    </footer>
    <button class="to-top" type="button" aria-label="Back to top" title="Back to top" data-to-top hidden>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 15V3M3.5 8.5 9 3l5.5 5.5" /></svg>
      <span class="to-top-label" aria-hidden="true">top</span>
    </button>
    <script src="../scripts/motion.js"></script>
  </body>
</html>
