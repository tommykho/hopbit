---
import { u } from '../../lib/url.js';
import Base from '../../layouts/Base.astro';
import Tape from '../../components/Tape.astro';
import Num from '../../components/Num.astro';
import TacticCard from '../../components/TacticCard.astro';
import PenDivider from '../../components/PenDivider.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import { chapters, ideaAnchor } from '../../lib/content.js';

export function getStaticPaths() {
  return chapters.map((c) => ({ params: { n: String(c.n) }, props: { c } }));
}
const { c } = Astro.props;
const prev = chapters[c.n - 2];
const next = chapters[c.n];
const cited = new Set(c.tactics.flatMap((t) => t.ideas));
const partIdx = c.part.chapters.indexOf(c.n) + 1;
---
<Base title={`Chapter ${c.n}: ${c.short}`} description={`${c.essence} ${c.modern_lens}`.slice(0, 300)}>
  <div class="progress" aria-hidden="true"><i data-progress></i></div>
  <div class="wrap chapter-bar"><span class="eyebrow">Chapter</span><ChapterNav current={c.n} label="Jump to chapter" /></div>

  <header class="ch-hero" data-color={c.part.color}>
    <div class="wrap ch-hero-grid">
      <div>
        <p class="eyebrow" data-reveal>Chapter {c.n} of {chapters.length} · {c.part.label}{c.part.inverse ? ` · ${c.part.rule}` : ''}</p>
        <h1 data-reveal>{c.short}</h1>
        <p class="ch-title hand" data-reveal>{c.title}</p>
        <p class="lede" data-reveal>{c.essence}</p>
        <p class="ch-lens" data-reveal>{c.modern_lens}</p>
      </div>
      <div class="ch-hero-side" data-reveal="scale">
        <Num n={c.n} size="lg" color={c.part.color} />
        <Tape color={c.part.color}>{c.part.label} · {partIdx}/{c.part.chapters.length}</Tape>
        {c.part.inverse && <p class="flip hand">build: {c.part.rule.toLowerCase()}<br />break: {c.part.inverse.toLowerCase()}</p>}
      </div>
    </div>
  </header>

  <section class="wrap ideas-section" aria-labelledby="ideas-title">
    <div class="ideas-head">
      <div>
        <p class="eyebrow">Key ideas, in plain words</p>
        <h2 id="ideas-title">What this chapter teaches</h2>
      </div>
      <p class="hint">Original summaries written for this site, numbered for citation. Highlighted ideas are used by this chapter's tactics.</p>
    </div>
    <ol class="ideas">
      {c.ideas.map((i) => (
        <li class={`idea-row ${cited.has(i.id) ? 'is-key' : ''}`} id={ideaAnchor(i.id)} data-reveal>
          <a class="idea-row-id" href={`#${ideaAnchor(i.id)}`} aria-label={`Idea ${i.id}`}>{i.id}</a>
          <div class="idea-row-body">
            <h3>{i.name}</h3>
            <p>{i.text}</p>
            <p class="idea-try">{i.try}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="hint" style="margin-top:16px">Original summaries written for Hopbit. <a href={u('/about/#credits')}>Credits</a></p>
  </section>

  <PenDivider />

  {c.tactics.length > 0 && (
    <section class="section wrap" aria-labelledby="tactics-title">
      <p class="eyebrow" data-reveal>Apply it</p>
      <h2 id="tactics-title" data-reveal>Tactics from chapter {c.n}</h2>
      <div class="grid" style="margin-top:28px">
        {c.tactics.map((t) => <TacticCard t={t} />)}
      </div>
    </section>
  )}

  <nav class="wrap ch-nav" aria-label="Chapter navigation">
    {prev ? <a class="card" data-color={prev.part.color} href={u(`/chapters/${prev.n}/`)}><span class="eyebrow">← Chapter {prev.n}</span><h3>{prev.short}</h3></a> : <a class="card" href={u('/chapters/')}><span class="eyebrow">← All chapters</span><h3>The book, mapped</h3></a>}
    {next ? <a class="card next" data-color={next.part.color} href={u(`/chapters/${next.n}/`)}><span class="eyebrow">Chapter {next.n} →</span><h3>{next.short}</h3></a> : <a class="card next" href={u('/challenge/')}><span class="eyebrow">Finished all 20 →</span><h3>Test yourself in the Habit Challenge</h3></a>}
  </nav>
</Base>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60; }
  .progress i { display: block; height: 100%; background: var(--hl); transform: scaleX(0); transform-origin: left; }
  .ch-hero { padding: 40px 0 56px; }
  .ch-hero-grid { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 40px; align-items: center; }
  .ch-hero h1 { color: var(--law); }
  .ch-title { font-size: clamp(1.5rem, 1vw + 1.1rem, 2rem); line-height: 1.15; color: var(--ink-2); margin-top: -6px; }
  .ch-lens { color: var(--ink-2); max-width: 62ch; }
  .ch-hero-side { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .ch-hero-side :global(.num) { --size: 150px; }
  .flip { margin: 0; font-size: 1.35rem; line-height: 1.2; color: var(--ink-2); }
  @media (max-width: 760px) {
    .ch-hero-grid { grid-template-columns: 1fr; }
    .ch-hero-side { flex-direction: row; order: -1; justify-content: flex-start; flex-wrap: wrap; text-align: left; }
    .ch-hero-side :global(.num) { --size: 84px; }
  }
  .ideas-section { padding-block: 24px 40px; }
  .ideas-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .ideas-head h2 { margin: 0; }
  .ideas-head .hint { max-width: 44ch; }
  .ideas { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .idea-row { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 6px 14px; padding: 24px 24px 22px 0; border-radius: 6px; background: var(--paper-2); border: 1px solid var(--line); box-shadow: var(--shadow); scroll-margin-top: 96px; }
  .idea-row::before { content: ''; position: absolute; left: 56px; top: 0; bottom: 0; width: 1.5px; background: var(--margin); }
  .idea-row:target { box-shadow: 0 0 0 3px var(--hl), var(--shadow); }
  .idea-row-id { font: 700 0.75rem var(--f-ui); color: var(--red); text-decoration: none; text-align: center; padding-top: 0.5em; }
  .idea-row.is-key .idea-row-id { background: var(--hl); color: #25231f; border-radius: 4px; margin: 0 8px; padding: 0.3em 0; align-self: start; }
  .idea-row-body { padding-left: 12px; }
  .idea-row h3 { margin: 0 0 6px; font-size: clamp(1.2rem, 0.7vw + 1rem, 1.5rem); }
  .idea-row p { margin: 0 0 10px; color: var(--ink-2); }
  .idea-row .idea-try { margin: 0; }
  @media (min-width: 980px) {
    .idea-row-body { display: grid; grid-template-columns: 1.5fr 1fr; gap: 6px 28px; align-items: start; }
    .idea-row-body h3 { grid-column: 1 / -1; }
    .idea-row .idea-try { padding: 10px 14px; border-left: 2px dashed var(--line-2); }
  }
  .ch-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-bottom: 80px; }
  .ch-nav .next { text-align: right; }
  .ch-nav .next .eyebrow { justify-content: flex-end; }
  @media (max-width: 700px) { .ch-nav { grid-template-columns: 1fr; } }
</style>
