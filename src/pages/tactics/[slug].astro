---
import { u } from '../../lib/url.js';
import Base from '../../layouts/Base.astro';
import Tape from '../../components/Tape.astro';
import Num from '../../components/Num.astro';
import IdeaCard from '../../components/IdeaCard.astro';
import TacticCard from '../../components/TacticCard.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import { tactics, chapterOf, relatedTactics, DOMAINS, MODES } from '../../lib/content.js';

export function getStaticPaths() {
  return tactics.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const ch = chapterOf(t.chapter);
const pos = tactics.findIndex((x) => x.slug === t.slug);
const prevT = tactics[pos - 1];
const nextT = tactics[pos + 1];
const inChapter = tactics.filter((x) => x.chapter === t.chapter);
const chPos = inChapter.findIndex((x) => x.slug === t.slug) + 1;
const related = relatedTactics(t, 3);
const effortLabel = { minutes: 'Minutes to set up', hours: 'A few hours', days: 'Over several days' }[t.effort];
const diffLabel = ['', 'Easy', 'Moderate', 'Advanced'][t.difficulty];
---
<Base title={t.title} description={`${t.situation} ${t.principle}. Chapter ${ch.n}: ${ch.short}.`}>
  <div class="wrap chapter-bar"><span class="eyebrow">Chapter</span><ChapterNav current={t.chapter} mode="tactics" withAll label="Tactics by chapter" /></div>

  <article class="tactic" data-color={ch.part.color}>
    <header class="t-hero">
      <div class="wrap t-hero-grid">
        <div>
          <nav class="crumbs" aria-label="Breadcrumb"><a href={u('/tactics/')}>Tactics</a> / <a href={u(`/tactics/?ch=${ch.n}`)}>Chapter {ch.n} · {ch.short}</a> / <span>{chPos} of {inChapter.length}</span></nav>
          <h1 data-reveal>{t.title}</h1>
          <p class="t-situation" data-reveal>{t.situation}</p>
          <div class="card-meta" data-reveal>
            <span class="chip chip--hl">{DOMAINS[t.domain].label}</span>
            <span class={`chip ${t.mode === 'break' ? 'chip--break' : ''}`}>{MODES[t.mode]}</span>
            <span class="chip">{diffLabel}</span>
            <span class="chip">{effortLabel}</span>
            <span class="chip">Idea: {t.principle}</span>
          </div>
        </div>
        <div class="t-side" data-reveal="scale">
          <Num n={ch.n} size="lg" color={ch.part.color} />
          <Tape color={ch.part.color}>{ch.part.label}{ch.part.inverse ? ` · ${t.mode === 'break' ? ch.part.inverse : ch.part.rule}` : ''}</Tape>
        </div>
      </div>
    </header>

    <section class="narrow t-scene">
      <p data-split>{t.scene}</p>
    </section>

    <section class="narrow">
      <p class="eyebrow" data-reveal>The ideas behind it</p>
      <div class="t-ideas">
        {t.ideas.map((id) => <IdeaCard id={id} />)}
      </div>
    </section>

    <section class="narrow t-moves" aria-labelledby="moves-title">
      <p class="eyebrow" data-reveal>The system</p>
      <h2 id="moves-title" data-reveal>How to apply it</h2>
      <ol class="moves">
        {t.moves.map((m, i) => (
          <li class="move" data-reveal="left">
            <label class="move-check">
              <input type="checkbox" data-move={`${t.slug}:${i}`} />
              <span class="box" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5 l4.5 4.5 L19 6" /></svg></span>
              <span class="sr-only">Mark step {i + 1} done</span>
            </label>
            <div>
              <h3><span class="move-n hand">{i + 1}.</span> {m.title}</h3>
              <p>{m.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="narrow">
      <div class="script ruled" data-reveal>
        <div class="script-head">
          <Tape color="blue">{t.script.label}</Tape>
          <button class="btn btn--sm" type="button" data-copy="#script-text">Copy</button>
        </div>
        <pre id="script-text">{t.script.text}</pre>
      </div>
    </section>

    <section class="narrow t-checks">
      <div class="check check--backfire" data-reveal>
        <h3><span aria-hidden="true">!</span> Backfire check</h3>
        <p>{t.backfire}</p>
      </div>
      <div class="check check--signals" data-reveal>
        <h3><span aria-hidden="true">✓</span> Signs it is working</h3>
        <p>{t.signals}</p>
      </div>
    </section>

    <section class="narrow t-cta" data-reveal>
      <div class="panel cta-panel">
        <div>
          <h3>Your version is different?</h3>
          <p class="muted">Describe your exact situation and get a cited habit system, or turn this tactic into a 30-second podcast.</p>
        </div>
        <div class="cta-btns">
          <a class="btn btn--ink btn--sm" href={u(`/coach/?q=${encodeURIComponent(t.situation)}`)}>Ask the Coach</a>
          <a class="btn btn--sm" href={u(`/coach/?tactic=${t.slug}#podcast`)}>Make a 30s podcast</a>
        </div>
      </div>
    </section>
  </article>

  <nav class="wrap t-pager" aria-label="Tactic navigation">
    <div class="t-prevnext">
      {prevT ? <a class="card" data-color={chapterOf(prevT.chapter).part.color} href={u(`/tactics/${prevT.slug}/`)}><span class="eyebrow">← Previous tactic · Ch. {prevT.chapter}</span><h3>{prevT.title}</h3></a> : <span></span>}
      {nextT ? <a class="card next" data-color={chapterOf(nextT.chapter).part.color} href={u(`/tactics/${nextT.slug}/`)}><span class="eyebrow">Next tactic · Ch. {nextT.chapter} →</span><h3>{nextT.title}</h3></a> : <a class="card next" href={u('/challenge/')}><span class="eyebrow">Last tactic →</span><h3>Test yourself in the Habit Challenge</h3></a>}
    </div>
  </nav>

  <section class="section wrap" aria-labelledby="related-title">
    <p class="eyebrow">Related</p>
    <h2 id="related-title">Next small step</h2>
    <div class="grid" style="margin-top:24px">{related.map((r) => <TacticCard t={r} />)}</div>
  </section>
</Base>

<script>
  // Remember which steps the visitor ticked (per browser, optional).
  const KEY = 'op.moves';
  let done = {};
  try { done = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch { done = {}; }
  document.querySelectorAll('[data-move]').forEach((box) => {
    box.checked = !!done[box.dataset.move];
    box.addEventListener('change', () => {
      if (box.checked) done[box.dataset.move] = 1; else delete done[box.dataset.move];
      try { localStorage.setItem(KEY, JSON.stringify(done)); } catch { /* storage blocked */ }
    });
  });
</script>

<style>
  .t-hero { padding: 40px 0 36px; }
  .t-hero-grid { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }
  .crumbs { font: 500 0.8rem var(--f-ui); color: var(--ink-3); margin-bottom: 18px; }
  .crumbs a { text-decoration: none; color: var(--ink-2); }
  .crumbs span { color: var(--ink-3); }
  .t-pager { padding-top: 40px; }
  .t-prevnext { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .t-prevnext .next { text-align: right; }
  .t-prevnext .next .eyebrow { justify-content: flex-end; }
  @media (max-width: 700px) { .t-prevnext { grid-template-columns: 1fr; } }
  .t-situation { font-size: clamp(1.15rem, 0.9vw + 1rem, 1.45rem); color: var(--law); max-width: 52ch; }
  .t-side { display: grid; justify-items: center; gap: 14px; }
  .t-side :global(.num) { --size: 120px; }
  @media (max-width: 700px) { .t-hero-grid { grid-template-columns: 1fr; } .t-side { justify-items: start; order: -1; grid-auto-flow: column; align-items: center; } .t-side :global(.num) { --size: 72px; } }
  .t-scene { padding-block: 36px 52px; }
  .t-scene p { font-family: var(--f-display); font-size: clamp(1.35rem, 1.2vw + 1rem, 1.95rem); line-height: 1.38; margin: 0; }
  .t-ideas { display: grid; gap: 18px; margin: 16px 0 60px; }
  .moves { list-style: none; padding: 0; margin: 24px 0 52px; display: grid; gap: 0; }
  .move { display: grid; grid-template-columns: 44px 1fr; gap: 14px; padding: 22px 0; border-top: 1px dashed var(--line-2); }
  .move h3 { margin: 0 0 6px; font-size: 1.4rem; }
  .move-n { color: var(--red); font-size: 1.6rem; margin-right: 2px; }
  .move p { margin: 0; color: var(--ink-2); }
  .move-check { position: relative; width: 34px; height: 34px; cursor: pointer; margin-top: 2px; }
  .move-check input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .move-check .box { position: absolute; inset: 0; border: 2px solid var(--ink-2); border-radius: 6px 8px 5px 7px; transform: rotate(-3deg); display: grid; place-items: center; background: var(--paper-2); }
  .move-check svg { width: 26px; height: 26px; fill: none; stroke: var(--green); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 24; stroke-dashoffset: 24; transition: stroke-dashoffset 0.3s var(--ease); }
  .move-check input:checked + .box svg { stroke-dashoffset: 0; }
  .move-check input:focus-visible + .box { outline: 2px dashed var(--pen); outline-offset: 3px; }
  .script { position: relative; margin-bottom: 40px; padding: 30px 22px 22px 54px; border-radius: 6px; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .script-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 12px; }
  .script pre { margin: 0; white-space: pre-wrap; font: 400 1rem/32px var(--f-body); color: var(--ink); }
  .t-checks { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 40px; }
  .check { padding: 22px; border-radius: 6px; border: 1.5px dashed var(--line-2); background: var(--paper-2); }
  .check h3 { font-size: 1.2rem; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
  .check h3 span { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; font: 700 0.9rem var(--f-ui); color: var(--paper); }
  .check p { margin: 0; color: var(--ink-2); font-size: 0.98rem; }
  .check--backfire { border-color: color-mix(in srgb, var(--red) 55%, transparent); }
  .check--backfire h3 span { background: var(--red); }
  .check--signals { border-color: color-mix(in srgb, var(--green) 55%, transparent); }
  .check--signals h3 span { background: var(--green); }
  @media (max-width: 700px) { .t-checks { grid-template-columns: 1fr; } }
  .cta-panel { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .cta-panel h3 { margin-bottom: 4px; }
  .cta-panel p { margin: 0; }
  .cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
