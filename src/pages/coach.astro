---
import { u } from '../lib/url.js';
import Base from '../layouts/Base.astro';
import Tape from '../components/Tape.astro';
import { PROVIDERS } from '../scripts/field/providers.js';
import { KOKORO_VOICES } from '../scripts/field/tts.js';
import { RANKS, coachRank } from '../lib/ranks.js';

const groups = [...new Set(PROVIDERS.map((p) => p.group))];
const optionLabel = (p) => `${p.label} · ${coachRank(p.id, p.model).en}`;
const examples = [
  'I check Slack every few minutes and never finish my most important work.',
  'I want to go to the gym before work but always hit snooze.',
  'Our sales team agreed to log every call in the CRM, but nobody does.',
  'I scroll my phone in bed until 1am and wake up exhausted.',
  'I want my kids to read every day without me nagging them.',
  'I keep ordering takeaway even though I planned to cook.',
];
---
<Base title="Ask the Coach" description="Describe a habit you want to build or break and get a four-law system with verified idea citations, a ready-to-use script, a backfire check and a downloadable 30-second podcast. Bring your own free AI key.">
  <header class="f-hero wrap">
    <div>
      <p class="eyebrow" data-reveal>Ask the Coach · AI</p>
      <h1 data-reveal>What do you want to <span class="mark">start or stop?</span></h1>
      <p class="lede" data-reveal>An AI coach maps your habit loop, cites the ideas it relies on (checked against this manual), and builds a four-law system, a script to use and a 30-second podcast you can download.</p>
    </div>
    <Tape color="blue" data-reveal="scale" class="f-tape">cue · craving · response · reward</Tape>
  </header>

  <section class="wrap f-grid">
    <!-- ======== INPUT ======== -->
    <form class="panel f-input" data-form>
      <div class="field">
        <label for="situation">Your habit</label>
        <textarea id="situation" class="input" rows="7" maxlength="4000" required data-situation
          placeholder="What you want to start or stop, when it happens, what you have tried, and who else is involved. Leave out real names."></textarea>
        <p class="hint"><span data-chars>0</span>/4000 · Tip: say when and where it happens; leave out names and health details you would not share.</p>
      </div>
      <div class="examples" aria-label="Examples">
        {examples.map((e) => <button class="chip" type="button" data-example={e}>{e.length > 46 ? e.slice(0, 44) + '…' : e}</button>)}
      </div>

      <div class="provider-bar">
        <span class="rank-mark hand" data-rank-seal aria-hidden="true">1</span>
        <div class="provider-info">
          <span class="label">Your coach</span>
          <p class="provider-now" data-provider-now>—</p>
          <p class="rank-line" data-rank-line></p>
        </div>
        <button class="btn btn--sm" type="button" data-open-settings>Change coach</button>
      </div>

      <div class="f-actions">
        <button class="btn btn--ink" type="submit" data-ask>Ask the Coach</button>
        <button class="btn" type="button" data-manual>Manual only (no AI)</button>
        <button class="btn" type="button" data-stop hidden>Stop</button>
      </div>
      <p class="hint" data-status role="status" aria-live="polite"></p>
    </form>

    <!-- ======== OUTPUT ======== -->
    <section class="panel f-output" aria-labelledby="answer-title" data-output-panel>
      <div class="out-head">
        <h2 id="answer-title" class="label" data-answer-title>Your habit plan</h2>
        <div class="out-tools" hidden data-out-tools>
          <button class="chip" type="button" data-copy-answer>Copy</button>
          <button class="chip" type="button" data-share>Save as habit journal</button>
        </div>
      </div>
      <div class="answer" data-answer>
        <div class="empty-state">
          <div class="empty-mark hand" aria-hidden="true">1.01<sup>365</sup></div>
          <p>Small changes, repeated. Describe the habit and choose a coach, or press <strong>Manual only</strong> to search the ideas and tactic library instantly, with no AI or key.</p>
        </div>
      </div>
      <div class="verify" hidden data-verify></div>
      <div class="rate-box" hidden data-rate>
        <span class="label">Rate this coach's plan</span>
        <span class="rate-stars" role="group" aria-label="Rate this plan">
          {[1, 2, 3, 4, 5].map((n) => <button type="button" data-star={n} aria-label={`${n} of 5`}>★</button>)}
        </span>
        <span class="hint" data-rate-note></span>
      </div>
    </section>
  </section>

  <!-- ======== PODCAST ======== -->
  <section class="wrap section podcast" id="podcast" aria-labelledby="podcast-title">
    <div class="pod-grid">
      <div>
        <p class="eyebrow">30-second podcast</p>
        <h2 id="podcast-title">Turn the plan into a podcast.</h2>
        <p class="lede">The script fills in automatically from the AI answer, or from any tactic. Edit it, choose a voice, and download the MP3. The default voice runs on your device, so it is free and private.</p>
        <ul class="ticks-sm">
          <li><strong>On-device (Kokoro)</strong>: free, no key, about an 80 MB download the first time.</li>
          <li><strong>Your own key</strong>: Gemini (free tier), OpenAI or ElevenLabs voices.</li>
          <li><strong>English only for now</strong>: the podcast script is always written in English, even when the plan is in another language. Japanese, Cantonese and Mandarin voices are coming.</li>
        </ul>
      </div>
      <div class="panel pod-panel">
        <div class="field">
          <label for="script">Script</label>
          <textarea id="script" class="input" rows="6" data-script placeholder="Ask the Coach first, or open a tactic and press “Make a 30s podcast”."></textarea>
          <p class="hint"><span data-words>0</span> words · about <span data-secs>0</span> seconds (aim for 65–80 words ≈ 30 s) · English voices only for now; Japanese, Cantonese and Mandarin are coming.</p>
        </div>
        <div class="pod-row">
          <div class="field">
            <label for="engine">Voice engine</label>
            <select id="engine" class="input" data-engine>
              <option value="kokoro">On-device · Kokoro (free)</option>
              <option value="gemini">Gemini TTS (your key)</option>
              <option value="openai">OpenAI TTS (your key)</option>
              <option value="elevenlabs">ElevenLabs (your key)</option>
            </select>
          </div>
          <div class="field" data-kokoro-only>
            <label for="voice">Voice</label>
            <select id="voice" class="input" data-voice>
              {KOKORO_VOICES.map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </div>
          <div class="field" data-kokoro-only>
            <label for="speed">Pace <span data-speed-out>1.0×</span></label>
            <input id="speed" type="range" min="0.8" max="1.2" step="0.05" value="1" data-speed />
          </div>
        </div>
        <label class="check-row"><input type="checkbox" data-intro checked /> Add a soft chime intro and outro</label>
        <label class="check-row" data-kokoro-only><input type="checkbox" data-gpu /> Use the GPU when available (faster; falls back to CPU automatically)</label>
        <div class="f-actions">
          <button class="btn btn--ink" type="button" data-speak>Generate audio</button>
          <a class="btn" hidden data-download download="hopbit-habit-podcast.mp3">Download MP3</a>
        </div>
        <p class="hint" data-tts-status role="status" aria-live="polite"></p>
        <audio controls hidden data-audio></audio>
      </div>
    </div>
  </section>

  <!-- ======== SETTINGS DIALOG ======== -->
  <dialog class="settings" data-settings aria-labelledby="settings-title">
    <form method="dialog" class="settings-inner" data-settings-form>
      <div class="settings-head">
        <h2 id="settings-title">Settings &amp; keys</h2>
        <button class="btn btn--sm" value="close" aria-label="Close settings">Close</button>
      </div>
      <div class="notice">
        <span aria-hidden="true">🔒</span>
        <span><strong>Your keys stay in this browser.</strong> They are sent only to the provider you choose. NVIDIA and Meta calls pass through this site's relay, which forwards the key and never stores or logs it. <a href={u('/about/#privacy')}>Details</a></span>
      </div>

      <div class="field">
        <label for="provider">Coach (AI provider)</label>
        <select id="provider" class="input" data-provider>
          {groups.map((g) => (
            <optgroup label={g}>
              {PROVIDERS.filter((p) => p.group === g).map((p) => <option value={p.id}>{optionLabel(p)}</option>)}
            </optgroup>
          ))}
        </select>
        <p class="hint" data-provider-note></p>
      </div>
      <div class="field" data-key-row>
        <label for="apikey">API key</label>
        <div class="key-row">
          <input id="apikey" class="input" type="password" autocomplete="off" spellcheck="false" data-key placeholder="Paste your key" />
          <button class="btn btn--sm" type="button" data-toggle-key>Show</button>
        </div>
        <p class="hint"><a data-key-link target="_blank" rel="noopener">Get a key →</a></p>
      </div>
      <div class="field" data-base-row hidden>
        <label for="base">Base URL</label>
        <input id="base" class="input" type="url" data-base placeholder="https://llm.example.com/v1" />
      </div>
      <div class="field">
        <label for="model">Model</label>
        <div class="key-row">
          <input id="model" class="input" list="model-list" data-model autocomplete="off" />
          <button class="btn btn--sm" type="button" data-load-free hidden>Load free models</button>
        </div>
        <datalist id="model-list" data-model-list></datalist>
        <p class="model-rank" data-model-rank></p>
      </div>

      <details class="rank-ladder">
        <summary>Coach ranks (Kit → Moon Rabbit)</summary>
        <ol>
          {RANKS.map((r) => <li><span class="rank-chip hand">{r.mark}</span><strong>{r.en}</strong> {r.blurb}</li>)}
        </ol>
        <p class="hint">Ranks are an editorial estimate of each model's strength for this kind of coaching, not a benchmark. Rate plans yourself and your own score appears next to the coach.</p>
      </details>

      <details class="tts-keys">
        <summary>Podcast voice keys (optional)</summary>
        <div class="field"><label for="k-gemini">Gemini key (also used by the Gemini coach)</label><input id="k-gemini" class="input" type="password" autocomplete="off" data-tkey="gemini" /></div>
        <div class="pod-row">
          <div class="field"><label for="g-model">Gemini TTS model</label><input id="g-model" class="input" data-tset="geminiModel" /></div>
          <div class="field"><label for="g-voice">Gemini voice</label><input id="g-voice" class="input" data-tset="geminiVoice" /></div>
        </div>
        <div class="field"><label for="k-openai">OpenAI key</label><input id="k-openai" class="input" type="password" autocomplete="off" data-tkey="openai" /></div>
        <div class="field"><label for="o-voice">OpenAI voice</label><input id="o-voice" class="input" data-tset="openaiVoice" /></div>
        <div class="field"><label for="k-eleven">ElevenLabs key</label><input id="k-eleven" class="input" type="password" autocomplete="off" data-tkey="elevenlabs" /></div>
        <div class="field"><label for="e-voice">ElevenLabs voice ID</label><input id="e-voice" class="input" data-tset="elevenVoice" /></div>
      </details>

      <label class="check-row"><input type="checkbox" data-remember /> Remember keys on this device (otherwise they are forgotten when you close the tab)</label>
      <div class="f-actions">
        <button class="btn btn--ink" value="save" data-save>Save</button>
        <button class="btn" type="button" data-clear-keys>Forget all keys</button>
      </div>
    </form>
  </dialog>

  <div class="idea-pop" role="dialog" aria-modal="false" hidden data-idea-pop></div>
</Base>

<script src="../scripts/field/app.js"></script>

<style>
  .f-hero { padding: 130px 0 32px; display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .f-hero :global(.f-tape) { font-size: 0.72rem; margin-bottom: 18px; }
  @media (max-width: 760px) { .f-hero :global(.f-tape) { display: none; } }
  .f-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 22px; align-items: start; }
  @media (max-width: 960px) { .f-grid { grid-template-columns: 1fr; } }
  .f-input { display: grid; gap: 18px; position: sticky; top: 88px; }
  @media (max-width: 960px) { .f-input { position: static; } }
  .examples { display: flex; flex-wrap: wrap; gap: 6px; }
  .provider-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; border: 1.5px dashed var(--line-2); border-radius: 8px; background: var(--paper); }
  .provider-now { margin: 2px 0 0; font: 500 0.92rem var(--f-ui); color: var(--ink); }
  .provider-info { flex: 1; min-width: 0; }
  .rank-mark { flex: none; width: 46px; height: 46px; display: grid; place-items: center; border: 2px solid var(--red); border-radius: 48% 52% 45% 55% / 55% 45% 55% 45%; color: var(--red); font-size: 1.6rem; transform: rotate(-6deg); }
  .rank-mark.is-unranked { border-color: var(--ink-4); color: var(--ink-3); }
  .rank-line { margin: 2px 0 0; font: 600 0.78rem var(--f-ui); color: var(--c-amber); }
  .rank-line :global(.mine) { color: var(--ink-3); margin-left: 6px; font-weight: 500; }
  .model-rank { margin: 6px 0 0; font: 600 0.8rem var(--f-ui); color: var(--c-amber); }
  .rank-ladder { border: 1px dashed var(--line-2); border-radius: 8px; padding: 12px 16px; }
  .rank-ladder summary { cursor: pointer; font: 600 0.8rem var(--f-ui); color: var(--ink-2); }
  .rank-ladder ol { list-style: none; padding: 0; margin: 12px 0 8px; display: grid; gap: 8px; font: 400 0.85rem/1.5 var(--f-ui); color: var(--ink-2); }
  .rank-ladder strong { color: var(--ink); margin-right: 4px; }
  .rank-chip { display: inline-grid; place-items: center; width: 26px; height: 26px; margin-right: 8px; border: 2px solid var(--red); border-radius: 50%; color: var(--red); font-size: 1rem; vertical-align: -0.3em; }
  .rate-box { margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--line-2); display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .rate-box .label { margin: 0; }
  .rate-stars { display: inline-flex; gap: 2px; }
  .rate-stars button { background: none; border: 0; padding: 2px; cursor: pointer; font-size: 1.45rem; line-height: 1; color: var(--ink-4); transition: color 0.2s, transform 0.2s; }
  .rate-stars button.on, .rate-stars button:hover { color: var(--c-amber); }
  .rate-stars button:hover { transform: scale(1.15); }
  .provider-now :global(small) { color: var(--ink-3); }
  .f-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .f-output { min-height: 520px; }
  .out-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .out-head h2 { margin: 0; }
  .out-tools { display: flex; gap: 6px; }
  .answer { font-size: 1.02rem; }
  .answer :global(.ans-h) { font: 700 0.72rem var(--f-ui); letter-spacing: 0.18em; text-transform: uppercase; color: var(--c-amber); margin: 26px 0 10px; display: flex; align-items: center; gap: 10px; }
  .answer :global(.ans-h)::after { content: ''; flex: 1; height: 1px; border-top: 1px dashed var(--line-2); }
  .answer :global(.ans-h:first-child) { margin-top: 4px; }
  .answer :global(p), .answer :global(li) { color: var(--ink); }
  .answer :global(ol), .answer :global(ul) { padding-left: 1.3em; margin: 0 0 1em; display: grid; gap: 6px; }
  .answer :global(.cite) { font: 700 0.7rem var(--f-ui); padding: 0.15em 0.55em; border-radius: 999px; border: 1px solid var(--red); background: var(--hl-soft); color: var(--ink); cursor: pointer; vertical-align: 0.1em; }
  .answer :global(.cite--bad) { border-color: var(--ink-4); background: none; color: var(--ink-3); text-decoration: line-through; cursor: help; }
  .answer :global(.cursor) { display: inline-block; width: 8px; height: 1.1em; background: var(--pen); vertical-align: -0.2em; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .empty-state { display: grid; justify-items: center; text-align: center; gap: 10px; padding: 48px 12px; color: var(--ink-2); }
  .empty-mark { font-size: 3.6rem; color: var(--green); line-height: 1; }
  .answer :global(.error) { border: 1.5px dashed var(--red); background: color-mix(in srgb, var(--red) 8%, transparent); border-radius: 8px; padding: 14px 16px; white-space: pre-wrap; font: 400 0.9rem/1.55 var(--f-ui); }
  .verify { margin-top: 18px; border-top: 1px dashed var(--line-2); padding-top: 16px; display: grid; gap: 12px; }
  .verify :global(h3) { font: 700 0.72rem var(--f-ui); letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); margin: 0; }
  .verify :global(.vcard) { padding: 14px 16px; border-radius: 8px; border: 1px solid var(--line); background: var(--paper); font-size: 0.95rem; }
  .verify :global(.vcard .vid) { font: 700 0.72rem var(--f-ui); color: var(--red); text-decoration: none; }
  .verify :global(.badge) { font: 700 0.64rem var(--f-ui); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2em 0.6em; border-radius: 999px; margin-left: 6px; }
  .verify :global(.badge.ok) { background: color-mix(in srgb, var(--green) 18%, transparent); color: var(--green); }
  .verify :global(.badge.warn) { background: var(--hl-soft); color: var(--ink); }
  .verify :global(.badge.bad) { background: color-mix(in srgb, var(--red) 15%, transparent); color: var(--red); }
  .manual :global(.mt) { display: block; padding: 14px 16px; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; margin-bottom: 8px; background: var(--paper); }
  .manual :global(.mt:hover) { border-color: var(--ink); }

  .podcast { padding-top: 80px; }
  .pod-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(24px, 5vw, 64px); align-items: start; }
  @media (max-width: 960px) { .pod-grid { grid-template-columns: 1fr; } }
  .pod-panel { display: grid; gap: 16px; }
  .pod-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; align-items: end; }
  .ticks-sm { padding-left: 1.1em; color: var(--ink-2); font: 400 0.92rem/1.6 var(--f-ui); }
  .check-row { display: flex; gap: 10px; align-items: center; font: 400 0.86rem var(--f-ui); color: var(--ink-2); }
  .check-row input { accent-color: var(--green); width: 16px; height: 16px; }
  input[type='range'] { accent-color: var(--pen); width: 100%; }
  audio { width: 100%; }

  .settings { width: min(640px, calc(100vw - 32px)); max-height: calc(100vh - 32px); padding: 0; border: 1.5px solid var(--ink); border-radius: 10px; background: var(--paper-2); color: var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .settings::backdrop { background: rgba(20, 18, 14, 0.55); backdrop-filter: blur(3px); }
  .settings-inner { display: grid; gap: 18px; padding: 24px; }
  .settings-head { display: flex; justify-content: space-between; align-items: center; }
  .settings-head h2 { margin: 0; font-size: 1.8rem; }
  .key-row { display: flex; gap: 8px; }
  .tts-keys { border: 1px dashed var(--line-2); border-radius: 8px; padding: 12px 16px; display: grid; gap: 12px; }
  .tts-keys[open] { padding-bottom: 16px; }
  .tts-keys summary { cursor: pointer; font: 600 0.8rem var(--f-ui); color: var(--ink-2); }
  .tts-keys .field { margin-top: 10px; }

  .idea-pop { position: fixed; z-index: 80; max-width: min(420px, calc(100vw - 32px)); padding: 16px 18px; border-radius: 8px; border: 1.5px solid var(--ink); background: var(--paper-2); box-shadow: 5px 5px 0 var(--ink); font-size: 0.95rem; }
  .idea-pop :global(p) { margin: 0 0 8px; }
  .idea-pop :global(.pop-try) { font: 600 1.15rem/1.3 var(--f-hand); color: var(--pen); }
  .idea-pop :global(a) { font: 700 0.72rem var(--f-ui); color: var(--red); text-decoration: none; letter-spacing: 0.04em; }
</style>
